# SUCCRA — environment template (Phase 0, no secrets).
# Source of truth for variable names: ARCHITECTURE.md §23.
# Copy to `.env` / `.env.local` for local development. Never commit real secrets.
# Rules (ARCHITECTURE.md §23):
# - `NEXT_PUBLIC_*` must never contain secrets.
# - Guardian secret is runtime-only.
# - Supabase service role is server-only.
# - Agent private keys live with agents and never in Succra.
# - `.env*` excluded from git except `.env.example`.

# --------------------------------------------------------------------
# DEPRECATION NOTICE — PIVOT TO HASHKEY CHAIN (2026-11-01)
# The Solana-era variables below are retained temporarily because
# some TypeScript in apps/ and packages/ still references them.
# Do NOT use them in new code. They will be removed once the gateway
# and SDK internals are replaced (Phase 2-3).
#
# DEPRECATED:
#   NEXT_PUBLIC_SOLANA_CLUSTER
#   SUCCRA_PROGRAM_ID
#   SUCCRA_GUARDIAN_PUBLIC_KEY
#   SUCCRA_GUARDIAN_SECRET_KEY
# --------------------------------------------------------------------
#
# HashKey Chain / HSP variables are documented below. Add new vars
# only in the HashKey section.

# ---- Web / server ----
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
SUCCRA_PROGRAM_ID=
SUCCRA_GUARDIAN_PUBLIC_KEY=
# Runtime guardian credential for POST /api/missions/:id/quarantine
# (server-only shared secret, constant-time compared; never logged).
SUCCRA_GUARDIAN_CREDENTIAL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Runtime-only ----
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY= (same as above, server-only)
# HELIUS_API_KEY= (same as above, server-only)
# HELIUS_WEBHOOK_SECRET= (same as above, server-only)
# SUCCRA_PROGRAM_ID= (same as above)
# Gateway fee-payer secret (base58 64-byte secret key, server-only).
# Funds only transaction fees; never signs as agent or vault.
SUCCRA_GATEWAY_FEE_PAYER_SECRET_KEY=
# OPENAI_API_KEY= (same as above)
# OPENAI_MODEL= (same as above)

# ---- HashKey Chain ----
NEXT_PUBLIC_HASHKEY_CHAIN_ID=177
NEXT_PUBLIC_HASHKEY_RPC_URL=https://mainnet.hsk.xyz
SUCCRA_MISSION_FACTORY_ADDRESS=
SUCCRA_GUARDIAN_ADDRESS=
SUCCRA_RPC_URL=

# ---- HSP (server-only) ----
HSP_API_BASE_URL=
HSP_MERCHANT_ID=
HSP_API_SECRET=
HSP_HMAC_SECRET=
HSP_WEBHOOK_SECRET=

# ---- Runtime-only ----
SUCCRA_GUARDIAN_SECRET_KEY=
