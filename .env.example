# SUCCRA — environment template (Phase 0, no secrets).
# Source of truth for variable names: ARCHITECTURE.md §23.
# Copy to `.env` / `.env.local` for local development. Never commit real secrets.
# Rules (ARCHITECTURE.md §23):
# - `NEXT_PUBLIC_*` must never contain secrets.
# - Guardian secret is runtime-only.
# - Supabase service role is server-only.
# - Agent private keys live with agents and never in Succra.
# - `.env*` excluded from git except `.env.example`.

# ---- Web / server ----
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
SUCCRA_PROGRAM_ID=
SUCCRA_GUARDIAN_PUBLIC_KEY=
SUCCRA_GUARDIAN_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Runtime-only ----
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY= (same as above, server-only)
# HELIUS_API_KEY= (same as above, server-only)
# HELIUS_WEBHOOK_SECRET= (same as above, server-only)
# SUCCRA_PROGRAM_ID= (same as above)
SUCCRA_RPC_URL=
# SUCCRA_GUARDIAN_SECRET_KEY= (same as above, runtime-only)
# Gateway fee-payer secret (base58 64-byte secret key, server-only).
# Funds only transaction fees; never signs as agent or vault.
SUCCRA_GATEWAY_FEE_PAYER_SECRET_KEY=
# OPENAI_API_KEY= (same as above)
# OPENAI_MODEL= (same as above)
